# Copy to /opt/waypoint/.env on the EC2 box and fill in. Never commit the real file.
GHCR_OWNER=your-github-username-lowercase
IMAGE_TAG=latest
SITE_HOST=your-name.duckdns.org
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
JWT_SECRET=change-me
MAPBOX_ACCESS_TOKEN=
# Gemini API key for the AI issue agent. Empty → agent off.
GEMINI_API_KEY=
GEMINI_MODEL=
# Driver phones simulate GPS along the route — handy for evaluators.
DEMO_MODE=true
