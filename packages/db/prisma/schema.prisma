// Waypoint — Unified Delivery System
// Prisma schema
//
// Conventions
//  - Reference data uses dataset IDs as PKs (OUT001, VEH003, district names).
//  - Operational data uses cuid PKs + human-readable `ref` for UI.
//  - Clock times of day are Int minutes since midnight (06:30 -> 390).
//  - Real instants are timestamptz; calendar dates are @db.Date.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  DISPATCHER
  LOADER
  DRIVER
  STORE_MANAGER
}

enum Brand {
  FRESH
  STYLE
  TECH
}

enum DockType {
  REAR_DOCK
  STREET
  MALL_BAY
}

enum ParkingConstraint {
  NORMAL
  VAN_ONLY
  MALL_DOCK
}

enum RoadClass {
  URBAN
  SUBURBAN
  HIGHWAY
  HILL
}

enum VehicleType {
  TRUCK
  VAN
}

enum VehicleTemp {
  REEFER
  AMBIENT
}

enum VehicleStatus {
  AVAILABLE
  IN_WORKSHOP
}

enum TempRequirement {
  CHILLED
  AMBIENT
}

enum OrderStatus {
  DRAFT // saved by the store, not yet submitted; invisible to dispatch
  SUBMITTED // confirmed before cutoff, waiting for planning
  PLANNED // on a published plan
  DEFERRED // moved to a later run
  LOADED
  IN_TRANSIT
  DELIVERED
  PARTIAL
  REFUSED
  RECEIVED // store manager confirmed receipt
  CANCELLED
}

enum PlanStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum TripStatus {
  PLANNED
  LOADING
  LOADED // released by loader
  DEPARTED
  COMPLETED
  CANCELLED
}

enum StopStatus {
  PENDING
  ARRIVED
  DELIVERED
  PARTIAL
  REFUSED
  SKIPPED
}

enum LoadStatus {
  PENDING
  STOWED
  FLAGGED
}

enum Decision {
  SERVED
  DEFERRED
}

enum DecisionSource {
  ENGINE
  DISPATCHER
}

// Matches the reason chips in the Figma deferral drawer
enum DeferralReason {
  REEFER_CAPACITY
  VEHICLE_CAPACITY
  FUEL_QUOTA
  DELIVERY_WINDOW
  ACCESS_RESTRICTION
  VEHICLE_UNAVAILABLE
  LOADING_SHORTFALL
  TIME_BUDGET
  LOWER_PRIORITY
  OTHER
}

enum DeliveryEventType {
  TRIP_DEPARTED
  ARRIVED
  DELIVERED
  PARTIAL
  REFUSED
  STOP_DEPARTED
  TRIP_COMPLETED
}

enum IssueStage {
  PLANNING
  LOADING
  DELIVERY
  RECEIPT
}

enum IssueType {
  LOAD_MISSING
  LOAD_DAMAGED
  CAPACITY_BREACH
  SEQUENCE_ISSUE
  DEPARTURE_DELAY
  LATE_ARRIVAL
  DELIVERY_REFUSED
  OUTLET_CLOSED
  ACCESS_BLOCKED
  VEHICLE_BREAKDOWN
  TEMPERATURE
  RECEIPT_MISSING
  RECEIPT_DAMAGED
  RECEIPT_WRONG_ITEMS
  OTHER
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ReceiptStatus {
  CONFIRMED
  CONFIRMED_WITH_ISSUES
  DISPUTED
}

enum ChangeKind {
  WINDOW // receiving window
  ACCESS // dock type and parking constraint
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// How the store found a received line
enum LineCondition {
  GOOD
  DAMAGED
  EXPIRED
  WRONG_ITEM
}

enum MediaKind {
  SIGNATURE
  PHOTO
}

enum FuelEntryKind {
  PLANNED
  ACTUAL
  ADJUSTMENT
}

enum ConversationKind {
  DIRECT // dispatch desk <-> one person, no subject
  ISSUE // scoped to one issue
}

enum MessageKind {
  TEXT
  SYSTEM // posted by the platform (thread opened, issue resolved)
}

enum ForecastSource {
  BASELINE
  MODEL
}

// ───────────────────────── Reference data (CSV) ─────────────────────────

model Depot {
  id            String           @id // "PELIYAGODA" | "KANDY"
  name          String
  lat           Float? // map enrichment
  lng           Float?
  districts     District[]
  outlets       Outlet[]
  vehicles      Vehicle[]
  users         User[]
  plans         Plan[]
  orders        Order[]
  demand        DemandWeekly[]
  forecasts     DemandForecast[]
  conversations Conversation[]
}

// district_travel.csv
model District {
  id                 String          @id // district name, e.g. "Colombo"
  depotId            String
  depot              Depot           @relation(fields: [depotId], references: [id])
  roadClass          RoadClass
  freeFlowKmh        Float
  depotToDistrictKm  Float
  depotToDistrictMin Float // depot_to_district_freeflow_min
  interStopKm        Float
  interStopMin       Float // inter_stop_freeflow_min
  centroidLat        Float? // our enrichment for the map, documented
  centroidLng        Float?
  outlets            Outlet[]
  trips              Trip[]
  trafficSpeeds      TrafficSpeed[]
  roadConditions     RoadCondition[]
}

// outlets.csv
model Outlet {
  id                 String                @id // "OUT001"
  name               String
  brand              Brand
  districtId         String
  district           District              @relation(fields: [districtId], references: [id])
  depotId            String
  depot              Depot                 @relation(fields: [depotId], references: [id])
  dockType           DockType
  parkingConstraint  ParkingConstraint
  mallWindowOpenMin  Int?
  mallWindowCloseMin Int?
  windowOpenMin      Int
  windowCloseMin     Int
  lastDeliveredOn    DateTime?             @db.Date // drives "days since last served"
  lat                Float? // map enrichment: deterministic point near the district centre
  lng                Float?
  managers           User[]
  orders             Order[]
  issues             Issue[]
  profile            OutletProfile?
  changeRequests     OutletChangeRequest[]

  @@index([depotId, brand, districtId])
}

// What the store tells us about itself. Not part of the datathon CSVs, so it lives beside the outlet.
model OutletProfile {
  outletId              String   @id
  outlet                Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  address               String?
  phone                 String?
  email                 String?
  tradingOpenMin        Int?
  tradingCloseMin       Int?
  floorAreaM2           Int?
  departments           Json     @default("[]") // [{ name, areaM2 }]: the footprint of each department
  leadership            Json     @default("[]") // [{ role, name, phone, email }]
  receivingContactName  String?
  receivingContactPhone String?
  receivingStaff        Int?
  hasForklift           Boolean  @default(false)
  hasColdRoom           Boolean  @default(false)
  receivingNotes        String?
  updatedAt             DateTime @updatedAt @db.Timestamptz
}

// A store asking for something that changes how it is planned (window, dock, parking). The dispatcher decides.
model OutletChangeRequest {
  id            String        @id @default(cuid())
  outletId      String
  outlet        Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  kind          ChangeKind
  current       Json
  proposed      Json
  reason        String
  status        RequestStatus @default(PENDING)
  requestedById String
  requestedBy   User          @relation("ChangeRequestedBy", fields: [requestedById], references: [id])
  createdAt     DateTime      @default(now()) @db.Timestamptz
  decidedById   String?
  decidedBy     User?         @relation("ChangeDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?     @db.Timestamptz
  decisionNote  String?

  @@index([outletId, status])
}

// vehicles.csv
model Vehicle {
  id               String            @id // "VEH001"
  type             VehicleType
  temp             VehicleTemp
  weightCapKg      Float
  volumeCapM3      Float
  fuelType         String
  kmPerL           Float
  weeklyFuelQuotaL Float
  depotId          String
  depot            Depot             @relation(fields: [depotId], references: [id])
  status           VehicleStatus     @default(AVAILABLE)
  driver           User?             @relation("DriverVehicle")
  trips            Trip[]
  fuelEntries      FuelLedgerEntry[]
  issues           Issue[]

  @@index([depotId, temp, type])
}

// service_allowance.csv
model ServiceAllowance {
  brand    Brand
  dockType DockType
  minutes  Float

  @@id([brand, dockType])
}

// calendar.csv
model CalendarDay {
  date         DateTime @id @db.Date
  dow          Int // 0 = Monday
  dowName      String
  isWeekend    Boolean
  isoYear      Int
  isoWeek      Int
  isPayday     Boolean
  festival     String?
  festivalRamp Float // 0..1
  isHoliday    Boolean
  monsoon      Boolean
  isOperating  Boolean

  @@index([isoYear, isoWeek])
}

// traffic_speed.csv — used for "at risk" ETA flags
model TrafficSpeed {
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  hour       Int
  monsoon    Boolean
  speedIndex Float // 100 = free flow

  @@id([districtId, hour, monsoon])
}

// road_conditions.csv
model RoadCondition {
  date            DateTime @db.Date
  districtId      String
  district        District @relation(fields: [districtId], references: [id])
  disruptionIndex Float // 100 = clear

  @@id([date, districtId])
}

// ─────────────────────────────── Identity ───────────────────────────────

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  phone             String?
  passwordHash      String
  role              Role
  depotId           String? // dispatcher / loader scope
  depot             Depot?   @relation(fields: [depotId], references: [id])
  outletId          String? // store manager scope
  outlet            Outlet?  @relation(fields: [outletId], references: [id])
  vehicleId         String?  @unique // driver's assigned vehicle
  vehicle           Vehicle? @relation("DriverVehicle", fields: [vehicleId], references: [id])
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz
  notificationPrefs Json?

  ordersCreated         Order[]               @relation("OrderCreatedBy")
  plansPublished        Plan[]                @relation("PlanPublishedBy")
  decisionsMade         PlanDecision[]        @relation("DecisionOverriddenBy")
  tripsLoaded           Trip[]                @relation("TripLoadedBy")
  tripsClaimed          Trip[]                @relation("TripClaimedBy")
  linesCounted          LoadLine[]            @relation("LoadLineCountedBy")
  tripsDriven           Trip[]                @relation("TripDriver")
  tripsLoading          Trip[]                @relation("TripLoader")
  deliveryEvents        DeliveryEvent[]
  locations             DriverLocation[]
  issueChatMembers      IssueChatMember[]
  issueChatMessages     IssueChatMessage[]
  issuesReported        Issue[]               @relation("IssueReportedBy")
  issuesResolved        Issue[]               @relation("IssueResolvedBy")
  receipts              Receipt[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  conversations         Conversation[]        @relation("ConversationMember")
  messagesSent          Message[]             @relation("MessageSender")
  changeRequestsMade    OutletChangeRequest[] @relation("ChangeRequestedBy")
  changeRequestsDecided OutletChangeRequest[] @relation("ChangeDecidedBy")
}

// ──────────────────────────────── Orders ────────────────────────────────

model Order {
  id              String          @id @default(cuid())
  ref             String          @unique // "ORD-000123"
  clientRequestId String?         @unique // idempotent submit
  outletId        String
  outlet          Outlet          @relation(fields: [outletId], references: [id])
  brand           Brand // denormalised from outlet for planning queries
  depotId         String
  depot           Depot           @relation(fields: [depotId], references: [id])
  deliveryDate    DateTime        @db.Date // current target run
  requestedDate   DateTime        @db.Date // date the store asked for (Task 2A rule)
  temp            TempRequirement
  units           Int
  weightKg        Float
  volumeM3        Float
  status          OrderStatus     @default(SUBMITTED)
  deferCount      Int             @default(0)
  notes           String?
  windowPref      String? // store's preferred receiving slot, "HH:MM-HH:MM"; a preference, not a planner constraint
  submittedAt     DateTime        @default(now()) @db.Timestamptz
  updatedAt       DateTime        @updatedAt @db.Timestamptz
  createdById     String
  createdBy       User            @relation("OrderCreatedBy", fields: [createdById], references: [id])
  lines           OrderLine[]
  decisions       PlanDecision[]
  stops           Stop[]
  receipt         Receipt?
  issues          Issue[]

  @@index([depotId, deliveryDate, status])
  @@index([outletId, deliveryDate])
}

// The loader's item checklist: units counted onto the truck per order line of a stop.
// Missing = ordered - loaded - damaged. Keyed by stop, so a re-planned order starts a fresh count.
model LoadLine {
  stopId      String
  stop        Stop      @relation(fields: [stopId], references: [id], onDelete: Cascade)
  orderLineId String
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  loadedQty   Int // good units on the truck
  damagedQty  Int       @default(0)
  countedById String
  countedBy   User      @relation("LoadLineCountedBy", fields: [countedById], references: [id])
  countedAt   DateTime  @updatedAt @db.Timestamptz

  @@id([stopId, orderLineId])
}

// What a store can order. Unit weight/volume are calibrated to each brand's real average per unit.
model Product {
  id           String          @id @default(cuid())
  sku          String          @unique
  name         String
  brand        Brand
  category     String
  temp         TempRequirement
  unitLabel    String // "1 L pack", "carton", "each"
  unitWeightKg Float
  unitVolumeM3 Float
  maxQty       Int             @default(200) // per order line
  isActive     Boolean         @default(true)
  lines        OrderLine[]

  @@index([brand, temp, isActive])
}

model OrderLine {
  id            String         @id @default(cuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description   String
  category      String // DAIRY, MEAT, PRODUCE, DRY, GARMENT, APPLIANCE ...
  productId     String? // null for historical orders imported from the datathon CSVs
  product       Product?       @relation(fields: [productId], references: [id])
  quantity      Int
  weightKg      Float
  volumeM3      Float
  deliveryLines DeliveryLine[]
  receiptLines  ReceiptLine[]
  issues        Issue[]
  loadLines     LoadLine[]
}

// ─────────────────────────────── Planning ───────────────────────────────

model Plan {
  id            String         @id @default(cuid())
  depotId       String
  depot         Depot          @relation(fields: [depotId], references: [id])
  date          DateTime       @db.Date
  version       Int
  status        PlanStatus     @default(DRAFT)
  engineVersion String
  summary       Json // demand vs capacity, limiting resources, KPIs
  generatedAt   DateTime       @default(now()) @db.Timestamptz
  publishedAt   DateTime?      @db.Timestamptz
  publishedById String?
  publishedBy   User?          @relation("PlanPublishedBy", fields: [publishedById], references: [id])
  trips         Trip[]
  decisions     PlanDecision[]

  @@unique([depotId, date, version])
  @@index([depotId, date, status])
}

// One row per order per plan: the explainability record
model PlanDecision {
  id                String          @id @default(cuid())
  planId            String
  plan              Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id])
  decision          Decision
  source            DecisionSource  @default(ENGINE)
  priorityScore     Float
  scoreBreakdown    Json // { deferredYesterday: 40, chilled: 20, festivalRamp: 8, ... }
  reason            DeferralReason?
  explanation       String? // "No reefer left for Colombo after 6 chilled orders"
  consecutiveDefers Int             @default(0)
  note              String?
  overriddenById    String?
  overriddenBy      User?           @relation("DecisionOverriddenBy", fields: [overriddenById], references: [id])
  createdAt         DateTime        @default(now()) @db.Timestamptz

  @@unique([planId, orderId])
  @@index([orderId])
}

model Trip {
  id                 String            @id @default(cuid())
  ref                String // "TRIP-019", unique within plan
  planId             String
  plan               Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  vehicleId          String
  vehicle            Vehicle           @relation(fields: [vehicleId], references: [id])
  tripNo             Int // 1 or 2
  brand              Brand
  districtId         String
  district           District          @relation(fields: [districtId], references: [id])
  status             TripStatus        @default(PLANNED)
  plannedDepartMin   Int
  plannedDurationMin Float // outbound + inter-stop + handling (Task 2B formula)
  plannedKm          Float
  plannedFuelL       Float
  loadWeightKg       Float
  loadVolumeM3       Float
  loadedAt           DateTime?         @db.Timestamptz
  loadedById         String?
  loadedBy           User?             @relation("TripLoadedBy", fields: [loadedById], references: [id])
  claimedById        String?
  claimedBy          User?             @relation("TripClaimedBy", fields: [claimedById], references: [id])
  claimedAt          DateTime?         @db.Timestamptz
  driverId           String?
  /// Road geometry from Google Routes: { source, legs: [[lat,lng]...][], km, min, computedAt }
  route              Json?
  driver             User?             @relation("TripDriver", fields: [driverId], references: [id])
  /// Depot gate: both crew claim the trip, then the dispatcher starts it (or it starts itself a minute later). Held trips stay off the live board.
  driverClaimedAt    DateTime?         @db.Timestamptz
  loaderId           String?
  loader             User?             @relation("TripLoader", fields: [loaderId], references: [id])
  loaderClaimedAt    DateTime?         @db.Timestamptz
  heldAt             DateTime?         @db.Timestamptz
  liveAt             DateTime?         @db.Timestamptz
  updatedAt          DateTime          @updatedAt @db.Timestamptz
  departedAt         DateTime?         @db.Timestamptz
  completedAt        DateTime?         @db.Timestamptz
  stops              Stop[]
  deliveryEvents     DeliveryEvent[]
  locations          DriverLocation[]
  fuelEntries        FuelLedgerEntry[]
  issues             Issue[]

  @@unique([planId, vehicleId, tripNo])
  @@unique([planId, ref])
}

// One stop per order (brief: each dispatched order is its own stop)
model Stop {
  id                String           @id @default(cuid())
  tripId            String
  trip              Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id])
  seq               Int // delivery order; loader loads in reverse
  plannedArrivalMin Int
  plannedWaitMin    Float            @default(0) // early arrival waits for window
  plannedServiceMin Float
  etaMin            Int? // live estimate, refreshed from driver events
  etaUpdatedAt      DateTime?        @db.Timestamptz
  atRisk            Boolean          @default(false)
  riskReason        String?
  status            StopStatus       @default(PENDING)
  loadStatus        LoadStatus       @default(PENDING)
  arrivedAt         DateTime?        @db.Timestamptz
  completedAt       DateTime?        @db.Timestamptz
  proof             ProofOfDelivery?
  events            DeliveryEvent[]
  issues            Issue[]
  loadLines         LoadLine[]

  @@unique([tripId, seq])
  @@index([orderId])
}

// ─────────────────────── Delivery (offline-first) ───────────────────────

// Append-only. `id` is generated on the driver's device, so replays are no-ops.
model DeliveryEvent {
  id         String            @id // client UUID
  tripId     String
  trip       Trip              @relation(fields: [tripId], references: [id])
  stopId     String?
  stop       Stop?             @relation(fields: [stopId], references: [id])
  driverId   String
  driver     User              @relation(fields: [driverId], references: [id])
  type       DeliveryEventType
  occurredAt DateTime          @db.Timestamptz // device clock
  receivedAt DateTime          @default(now()) @db.Timestamptz // server clock
  deviceId   String?
  payload    Json?

  @@index([tripId, occurredAt])
}

model ProofOfDelivery {
  id            String         @id // client UUID
  stopId        String         @unique
  stop          Stop           @relation(fields: [stopId], references: [id])
  recipientName String
  notes         String?
  capturedAt    DateTime       @db.Timestamptz
  signatureId   String?        @unique
  signature     MediaAsset?    @relation("PodSignature", fields: [signatureId], references: [id])
  photoId       String?        @unique
  photo         MediaAsset?    @relation("PodPhoto", fields: [photoId], references: [id])
  lines         DeliveryLine[]
}

model DeliveryLine {
  id           String          @id @default(cuid())
  podId        String
  pod          ProofOfDelivery @relation(fields: [podId], references: [id], onDelete: Cascade)
  orderLineId  String
  orderLine    OrderLine       @relation(fields: [orderLineId], references: [id])
  deliveredQty Int
  refusedQty   Int             @default(0)
  reason       String?
}

model MediaAsset {
  id           String           @id // client UUID
  kind         MediaKind
  mimeType     String
  sizeBytes    Int
  data         Bytes // compressed on the device, stored directly in Postgres
  createdAt    DateTime         @default(now()) @db.Timestamptz
  podSignature ProofOfDelivery? @relation("PodSignature")
  podPhoto     ProofOfDelivery? @relation("PodPhoto")
  issues       Issue[]
  issuePhoto   IssuePhoto?
}

// Extra photo evidence on an issue (up to 3). The bytes live in MediaAsset.data.
model IssuePhoto {
  id       String     @id @default(cuid())
  issueId  String
  issue    Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  mediaId  String     @unique
  media    MediaAsset @relation(fields: [mediaId], references: [id])
  position Int        @default(0)

  @@index([issueId, position])
}

// ─────────────────────────── Receipt & issues ───────────────────────────

model Receipt {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  status        ReceiptStatus
  notes         String?
  confirmedById String
  confirmedBy   User          @relation(fields: [confirmedById], references: [id])
  confirmedAt   DateTime      @default(now()) @db.Timestamptz
  lines         ReceiptLine[]
}

// One row per order line when the store counts a delivery in. A shortage is receivedQty < expectedQty.
model ReceiptLine {
  id          String        @id @default(cuid())
  receiptId   String
  receipt     Receipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLineId String
  orderLine   OrderLine     @relation(fields: [orderLineId], references: [id])
  expectedQty Int // what the driver recorded as delivered (DeliveryLine.deliveredQty), the baseline for the count
  receivedQty Int
  condition   LineCondition @default(GOOD)
  notes       String?

  @@unique([receiptId, orderLineId])
}

// Single exception table for every role and stage
model Issue {
  id           String        @id @default(cuid())
  ref          String        @unique // "ISS-0042"
  clientId     String?       @unique // offline-created issues
  stage        IssueStage
  type         IssueType
  severity     IssueSeverity @default(MEDIUM)
  status       IssueStatus   @default(OPEN)
  description  String
  quantity     Int?
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id])
  orderLineId  String?
  orderLine    OrderLine?    @relation(fields: [orderLineId], references: [id])
  tripId       String?
  trip         Trip?         @relation(fields: [tripId], references: [id])
  stopId       String?
  stop         Stop?         @relation(fields: [stopId], references: [id])
  vehicleId    String?
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])
  outletId     String?
  outlet       Outlet?       @relation(fields: [outletId], references: [id])
  photoId      String? // first photo, kept for older readers; every photo is listed in `photos`
  photo        MediaAsset?   @relation(fields: [photoId], references: [id])
  photos       IssuePhoto[]
  reportedById String
  reportedBy   User          @relation("IssueReportedBy", fields: [reportedById], references: [id])
  resolvedById String?
  resolvedBy   User?         @relation("IssueResolvedBy", fields: [resolvedById], references: [id])
  resolution   String?
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz
  resolvedAt   DateTime?     @db.Timestamptz
  chat         IssueChat?

  conversations Conversation[]

  @@index([status, stage])
  @@index([tripId])
}

// ──────────────────────────── Fuel & capacity ────────────────────────────

// Weekly quota check = SUM(litres) for vehicle + ISO week
model FuelLedgerEntry {
  id        String        @id @default(cuid())
  vehicleId String
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id])
  tripId    String?
  trip      Trip?         @relation(fields: [tripId], references: [id])
  date      DateTime      @db.Date
  isoYear   Int
  isoWeek   Int
  kind      FuelEntryKind
  km        Float
  litres    Float
  createdAt DateTime      @default(now()) @db.Timestamptz

  @@index([vehicleId, isoYear, isoWeek])
}

// Aggregated from deliveries_train.csv during seed
model DemandWeekly {
  depotId         String
  depot           Depot  @relation(fields: [depotId], references: [id])
  brand           Brand
  isoYear         Int
  isoWeek         Int
  orderCount      Int
  totalVolumeM3   Float
  chilledVolumeM3 Float

  @@id([depotId, brand, isoYear, isoWeek])
}

// Baseline now; Datathon Task 2A model output later
model DemandForecast {
  depotId         String
  depot           Depot          @relation(fields: [depotId], references: [id])
  brand           Brand
  isoYear         Int
  isoWeek         Int
  source          ForecastSource
  totalVolumeM3   Float
  chilledVolumeM3 Float
  createdAt       DateTime       @default(now()) @db.Timestamptz

  @@id([depotId, brand, isoYear, isoWeek, source])
}

// ───────────────────────────── Cross-cutting ─────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // ORDER_CONFIRMED, ORDER_DEFERRED, ETA_UPDATED, SHORTFALL ...
  title     String
  body      String
  link      String?
  readAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // PLAN_PUBLISHED, ORDER_DEFERRED, DECISION_OVERRIDDEN ...
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([entityType, entityId])
}

// cutoff time, Fresh/Style-Tech budgets, demo operating date
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz
}

// ───────────────────────────── Messaging ─────────────────────────────
// Star topology: every conversation is between one depot's dispatch desk and one
// member (loader, driver or store manager). Members never talk to each other.
// The desk side is shared by all dispatchers of the depot, so unread state is per side.

model Conversation {
  id            String           @id @default(cuid())
  key           String           @unique // "<memberId>:direct" | "<memberId>:<issueId>"
  kind          ConversationKind
  depotId       String
  depot         Depot            @relation(fields: [depotId], references: [id])
  memberId      String
  member        User             @relation("ConversationMember", fields: [memberId], references: [id], onDelete: Cascade)
  issueId       String?
  issue         Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime?        @db.Timestamptz
  deskUnread    Int              @default(0)
  memberUnread  Int              @default(0)
  deskClearedAt   DateTime?      @db.Timestamptz // the desk side hides everything up to here
  memberClearedAt DateTime?      @db.Timestamptz // the member side hides everything up to here
  createdAt     DateTime         @default(now()) @db.Timestamptz
  messages      Message[]

  @@index([depotId, lastMessageAt])
  @@index([memberId, lastMessageAt])
  @@index([issueId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String? // null for SYSTEM
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id])
  kind           MessageKind  @default(TEXT)
  body           String // plain text with @[type:id|label] mention tokens
  mentions       Json         @default("[]") // resolved [{ type, id, label }]
  clientId       String?      @unique // idempotent resend from flaky connections
  createdAt      DateTime     @default(now()) @db.Timestamptz

  @@index([conversationId, createdAt])
}

// ─────────────────────────── Driver tracking ───────────────────────────

// GPS fix from the driver's phone. `id` is a client UUID so offline batches replay safely.
// Sampled every few minutes while a trip is running (web apps cannot track in the background).
model DriverLocation {
  id         String   @id // client UUID
  driverId   String
  driver     User     @relation(fields: [driverId], references: [id])
  tripId     String?
  trip       Trip?    @relation(fields: [tripId], references: [id])
  lat        Float
  lng        Float
  accuracyM  Float?
  speedKmh   Float?
  heading    Float?
  simulated  Boolean  @default(false) // demo mode
  capturedAt DateTime @db.Timestamptz // device clock
  receivedAt DateTime @default(now()) @db.Timestamptz

  @@index([tripId, capturedAt])
  @@index([driverId, capturedAt])
}

// ─────────────────────────── Issue group chat ───────────────────────────

// One group chat per issue. Members are the people the issue affects (driver, loader, store
// manager). The dispatcher watches, changes the issue status and closes the chat; they do not post.
model IssueChat {
  id            String             @id @default(cuid())
  issueId       String             @unique
  issue         Issue              @relation(fields: [issueId], references: [id], onDelete: Cascade)
  depotId       String
  closedAt      DateTime?          @db.Timestamptz
  closedById    String?
  lastMessageAt DateTime?          @db.Timestamptz
  createdAt     DateTime           @default(now()) @db.Timestamptz
  members       IssueChatMember[]
  messages      IssueChatMessage[]

  @@index([depotId, lastMessageAt])
}

model IssueChatMember {
  chatId   String
  chat     IssueChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  relation String // "Driver on TRIP-013", "Store manager · Colombo 003"
  unread   Int       @default(0)
  joinedAt DateTime  @default(now()) @db.Timestamptz

  @@id([chatId, userId])
  @@index([userId])
}

model IssueChatMessage {
  id        String      @id @default(cuid())
  chatId    String
  chat      IssueChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId  String? // null for SYSTEM
  sender    User?       @relation(fields: [senderId], references: [id])
  kind      MessageKind @default(TEXT)
  body      String
  clientId  String?     @unique // idempotent resend from flaky connections
  createdAt DateTime    @default(now()) @db.Timestamptz

  @@index([chatId, createdAt])
}
