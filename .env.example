# ── Database ──────────────────────────────────────────────
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint
# Local dev (pnpm dev) talks to the dockerised db on host port 5434 (5432 is often taken by a local Postgres)
DB_PORT=5434
DATABASE_URL=postgresql://waypoint:waypoint@localhost:5434/waypoint?schema=public

# ── API ───────────────────────────────────────────────────
PORT=4000
JWT_SECRET=change-me-in-production
# Where the seed reads the competition CSVs from
DATA_DIR=../../data

# ── Web ───────────────────────────────────────────────────
# Server-side URL the Next.js /api proxy forwards to
API_URL=http://localhost:4000

# ── Ports on the host (Windows may reserve 2294-3309; override if 3000 is blocked) ──
WEB_PORT=3000

# ── Live operations ───────────────────────────────────────
# Mapbox public token (pk.…): map tiles in the browser + Directions API for road routes.
# Empty → schematic map with straight-line routes. Free tier covers this app easily.
MAPBOX_ACCESS_TOKEN=
# Gemini API key for the AI issue agent (dispatcher → issue → Agent tab). Empty → agent off.
# Put the real key only in your own .env, never in this file.
GEMINI_API_KEY=
# Optional: pin a Gemini model. Empty → gemini-flash-latest (always the current Flash model).
GEMINI_MODEL=
# Public URL browsers use for the live WebSocket. Empty → same host, port 4000.
PUBLIC_WS_URL=

# ── Driver app ────────────────────────────────────────────
# Demo mode: the driver's phone simulates GPS along the route (no driving needed) and pings every DEMO_PING_SECONDS.
DEMO_MODE=false
DEMO_PING_SECONDS=10
# Production: seconds between GPS pings while a trip is running (web apps cannot track in the background).
GPS_PING_SECONDS=240
# Metres from a stop at which the driver is offered "I've arrived".
ARRIVE_RADIUS_M=150

